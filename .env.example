# ==============================================================================
# MediPulse EHR - Environment Configuration
# ==============================================================================

# MongoDB Connection String:
# For local MongoDB: mongodb://localhost:27017/
# For Docker Compose: mongodb://mongodb:27017/
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb://localhost:27017/

# Target Database Name
DATABASE_NAME=medipulse_db

# Security & Session Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Host & Port (0.0.0.0 allows LAN / Cloud binding)
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=False
